{
  "expo": {
    "name": "keno",
    "slug": "keno",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keno",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alextamp.keno",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.KeNo.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBivBgxEI5WZweR4Lv9ERELbRRL6b1IYlg"
        }
      },
      "versionCode": 31
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B8482A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Keno uses your location to show nearby events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Keno needs access to your photos to set a profile picture or event cover."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Keno uses your calendar to add events you've joined."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Keno needs your camera to scan check-in QR codes and take photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Keno needs access to your photos to save photos from an event's photo wall.",
          "savePhotosPermission": "Keno needs permission to save photos to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-font",
      "expo-audio",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6994cc7-63bc-46d9-98a5-ce49a412909e"
      }
    }
  }
}