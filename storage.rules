rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Event cover photos — any signed-in user can upload/read
    match /events/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Group cover photos — any signed-in user can upload/read
    match /groups/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // DM photos — any signed-in user can upload/read
    match /dm-images/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars — filenames are "{uid}.{ext}", so this restricts writes
    // to the signed-in user's own avatar file.
    match /avatars/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '[.].+')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Student ID photos for the no-university-email signup path — private.
    // Only the uploader and the admin (kept in sync with
    // src/core/constants/admin.ts) can read them.
    match /verification-photos/{filename} {
      allow read: if request.auth != null
                  && (filename.matches(request.auth.uid + '[.].+')
                      || request.auth.uid == 'Ijfcvx8cqGb1WNnOZxWgGUuGD6N2');
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '[.].+')
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Optional screenshots attached to user-submitted "report an issue"
    // tickets (Settings → Safety & Privacy) — private, same access pattern
    // as verification-photos: only the uploader and the admin can read.
    match /issue-reports/{filename} {
      allow read: if request.auth != null
                  && (filename.matches(request.auth.uid + '_.+')
                      || request.auth.uid == 'Ijfcvx8cqGb1WNnOZxWgGUuGD6N2');
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '_.+')
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
