rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Backed by the admins collection (doc id = uid) instead of a single
    // hardcoded uid, so a second moderator can be added — or an existing
    // one revoked — by writing/deleting a Firestore doc, no redeploy
    // needed. That collection is server/console-only (see its own rule
    // below); exists() here bypasses the normal allow-read check on the
    // path it looks at, so this works even though clients can't read
    // other users' admins docs directly.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // The "keno" account (src/core/constants/eventsAccount.ts KENO_EVENTS_UID)
    // reviews auto-imported events from its OWN Settings screen, deliberately
    // separate from the general admin account/isAdmin() — it only ever needs
    // eventsPending access, not reports/verifications too. Approving an
    // event while signed in as this account already satisfies the plain
    // creatorId == request.auth.uid self-create check on /events and its
    // private/checkin doc (creatorId is set to this same uid), so this
    // function is only needed for the eventsPending rule below.
    function isEventsManager() {
      return signedIn() && request.auth.uid == 'ObDcfgYrUJQVHYhLcyZ5WetCxSE3';
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      // Owners can edit their whole profile. Anyone else may only union an
      // event into joinedEvents — needed when a leaving attendee promotes the
      // next person off an event's waitlist into someone else's joined list.
      // The admin may additionally strip a deleted event's id out of
      // createdEvents/joinedEvents when removing a reported event they don't own.
      // Attendance history (Anti-Flake system) can be updated by the user themselves only.
      allow update: if isOwner(userId) ||
        (isAdmin() && onlyChangedFields(['joinedEvents', 'createdEvents', 'idVerificationStatus', 'isBetaTester'])) ||
        (signedIn() && onlyChangedFields(['joinedEvents', 'followers', 'attendanceHistory'])) ||
        // A roll-call check-in (organizer checking someone else in) may also
        // touch checkInCount/xp/reliabilityScore/weeklyQuests, but xp only as
        // a bounded delta — never an arbitrary value — so a cross-user write
        // can't be used to inflate someone's (or your own, via a crafted
        // client) XP or ticket count. checkInCount is always exactly +1. xp
        // is checkinBonus (5) plus an optional RSVP stake refund (capped at
        // the UI's max stake of 60, see XP_VALUES.rsvpStakeOptions in
        // event/[id].tsx) plus an optional one-time checkin_event weekly
        // quest bonus (20) the first time it's completed that week — so the
        // valid range is [+5, +85]. Keep these in sync with
        // XP_VALUES.checkinBonus / rsvpStakeOptions in
        // src/core/constants/gamification.ts and WEEKLY_QUESTS in
        // src/core/constants/quests.ts.
        (signedIn() &&
          onlyChangedFields(['joinedEvents', 'followers', 'attendanceHistory', 'reliabilityScore', 'checkInCount', 'xp', 'weeklyQuests']) &&
          request.resource.data.checkInCount == resource.data.get('checkInCount', 0) + 1 &&
          request.resource.data.xp >= resource.data.get('xp', 0) + 5 &&
          request.resource.data.xp <= resource.data.get('xp', 0) + 85);
      allow delete: if isOwner(userId);

      // Per-user notifications (actual storage path — not the root collection below)
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if signedIn();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Per-user reviews (from other users)
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }

      // Sensitive documents (currently: ID verification photo) — never on
      // the public users/{userId} doc, since a Storage download URL's
      // embedded token bypasses storage.rules once it's readable from
      // anywhere. Owner and admin only, same as the actual file in Storage.
      match /private/{docId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if signedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // Events + subcollections
    match /events/{eventId} {
      allow read: if signedIn();
      // isAdmin() OR here is for approving an auto-imported event out of
      // eventsPending (admin-events.tsx): the signed-in admin is the one
      // performing the write, but creatorId is set to the "keno" events
      // account's uid, not the admin's own — the plain self-create check
      // below would otherwise reject that write.
      allow create: if signedIn() && (request.resource.data.creatorId == request.auth.uid || isAdmin());
      // Creator can edit everything; anyone else can only touch join/waitlist/reaction
      // state, XP stakes (for Anti-Flake system), or ask to join a private event via joinRequests.
      // referredBy is never client-writable — it's set by the claimReferral
      // Cloud Function only, which verifies the caller is actually attending
      // and can't overwrite an existing claim. (A prior version let any
      // signed-in user write onlyChangedFields(['referredBy']) directly,
      // which meant they could plant an arbitrary invitee uid -> their own
      // uid mapping for events they had nothing to do with, then farm the
      // referral XP off other people's organic check-ins.)
      // isFlagship is admin-only regardless of who owns the event — without
      // this, any creator could self-flag their own event (the app only
      // hides the toggle in the UI for non-admins, which a raw write bypasses)
      // and hijack the feed's pinned banner slot.
      // attendeeIds can only grow up to maxAttendees. The client's own
      // isEventFull() check can be stale (two people tapping Join on the
      // last spot at the same moment), but Firestore serializes writes to a
      // single document, so this check runs against the true committed
      // state for every write in order — the second joiner's write is
      // rejected here even though their local UI still showed room.
      // Shrinking the array (leaving) is always allowed regardless of cap.
      // Same isolated-field admin OR path as groups' isVerifiedOrganiser
      // above, for the same reason: an admin flagging an event they didn't
      // create must pass the first OR group too, and they're neither the
      // creator nor touching attendeeIds/etc — without this branch the
      // trailing isAdmin() check is unreachable for anyone but the event's
      // own creator, defeating the point of an admin-curated flagship slot.
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        onlyChangedFields(['attendeeIds', 'waitlistIds', 'reactions', 'joinRequests', 'rsvpStakes']) ||
        (isAdmin() && onlyChangedFields(['isFlagship']))
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['referredBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isFlagship']) || isAdmin())
        && (request.resource.data.attendeeIds.size() <= resource.data.attendeeIds.size()
            || request.resource.data.attendeeIds.size() <= resource.data.get('maxAttendees', 999999));
      allow delete: if signedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());

      // Chat messages — auto-expiring 24h after the event starts (research
      // doc #8), enforced here too so a modified client can't keep posting
      // into a thread the UI has already closed. sweepExpiredChats (Cloud
      // Function) deletes the backlog itself once the window has passed.
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid &&
          request.time < get(/databases/$(database)/documents/events/$(eventId)).data.dateTime + duration.value(24, 'h');
        // Reactions are added/removed by anyone; only the author may edit
        // (text/editedAt) or soft-delete (isDeleted, clearing text/imageUri)
        // their own message.
        allow update: if signedIn() && (
          onlyChangedFields(['reactions']) ||
          (resource.data.userId == request.auth.uid && onlyChangedFields(['text', 'editedAt', 'isDeleted', 'imageUri']))
        );
        allow delete: if false;
      }

      // Photo wall — post-event shared photos. Posting is restricted to
      // people who actually checked in (a real checkIns doc must exist for
      // them on this event), not just anyone who joined/RSVP'd — otherwise
      // someone who never showed up could post photos claiming they were
      // there. Reading stays open to any signed-in user, same as before.
      match /photos/{photoId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uploaderUid == request.auth.uid &&
          exists(/databases/$(database)/documents/events/$(eventId)/checkIns/$(request.auth.uid));
        allow update, delete: if false;
      }

      // Private per-event data only the creator (or a stand-in host who
      // claimed hosting duties via claimStandInHost, see events/{eventId}
      // standInHostId) can read — currently just the QR check-in secret
      // (events.repository.impl's createEvent / checkInWithToken).
      match /private/{docId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.standInHostId == request.auth.uid
        );
        // Same isAdmin() OR as the parent event's create rule — approving a
        // pending event writes its check-in secret as the admin, not as the
        // "keno" account that ends up as creatorId.
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid || isAdmin()
        );
        allow update, delete: if false;
      }

      // Check-ins for solo buddy matching + the real QR/roll-call record.
      // A self check-in must prove it saw the rotating secret + a bucket
      // within one 30s window (±45s) of now; the event creator (or a
      // stand-in host who took over — see standInHostId above) can always
      // write on someone else's behalf (manual roll-call fallback).
      match /checkIns/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == userId && (
          get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.standInHostId == request.auth.uid ||
          (
            request.auth.uid == userId &&
            request.resource.data.secret == get(/databases/$(database)/documents/events/$(eventId)/private/checkin).data.secret &&
            request.resource.data.bucket is number &&
            (request.resource.data.bucket * 30000) > (request.time.toMillis() - 45000) &&
            (request.resource.data.bucket * 30000) < (request.time.toMillis() + 45000)
          )
        );
        // Two allowed updates: the owner adding the one-time "did you come
        // alone?" flag the success screen asks post-check-in (solo-buddy-
        // matching signal) — never touching secret/bucket/timestamp — or
        // any other signed-in user toggling themselves in/out of `kudos`
        // (Strava-Kudos-style acknowledgment), same trust model as chat
        // message reactions above (arrayUnion/Remove of the caller's own
        // uid, not enforced field-by-field here).
        allow update: if signedIn() && (
          (request.auth.uid == userId &&
            onlyChangedFields(['arrivedSolo']) &&
            request.resource.data.arrivedSolo is bool) ||
          (request.auth.uid != userId && onlyChangedFields(['kudos'])) ||
          (request.auth.uid == userId &&
            onlyChangedFields(['feedback']) &&
            request.resource.data.feedback in ['good', 'bad'])
        );
        allow delete: if false;
      }

      // Swipes for mutual matching (post-event)
      match /swipes/{swipeId} {
        allow read: if signedIn() && request.auth.uid == resource.data.fromUid;
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
        allow update: if false;
        allow delete: if false;
      }

      // Typing indicators
      match /typing/{userId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // Candidate events found by the events-ingestion script (ΒΗΜΑ 3),
    // awaiting a human decision in admin-events.tsx before they ever become
    // a real, visible event. Only the Admin SDK (service account, bypasses
    // these rules entirely) ever creates docs here — no client write path
    // exists, intentionally. Admins can read to review and delete once
    // they've approved (copied into /events) or rejected a candidate.
    match /eventsPending/{id} {
      allow read: if isAdmin() || isEventsManager();
      allow create, update: if false;
      allow delete: if isAdmin() || isEventsManager();
    }

    // Direct message conversations — gated to the two participants only.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Either participant may react; only the sender may edit or
        // soft-delete their own message.
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          (
            onlyChangedFields(['reactions']) ||
            (request.auth.uid == resource.data.senderId && onlyChangedFields(['isDeleted', 'text', 'editedAt']))
          );
        allow delete: if false;
      }
    }

    // Communities / groups
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      // Creator can edit everything; members can only join/leave or accept invites,
      // any signed-in user can attach an event they posted to the group, and
      // anyone can ask to join a private group via joinRequests.
      // isVerifiedOrganiser is admin-only regardless of who owns the group —
      // without this extra check, the "creator can edit everything" branch
      // above would let any group creator self-grant the verified badge via
      // a raw write, bypassing the admin-only toggle in the UI (same class
      // of bug as isFlagship on events).
      // The admin branch below is a dedicated, isolated-field OR path (not
      // just the trailing isAdmin() check further down) — an admin
      // verifying/unverifying a group they didn't create must still pass
      // *some* branch of this first OR group to be allowed to write at
      // all, and they're neither the creator nor touching memberIds etc.
      // A rules-unit-testing regression test (firestore-tests/rules.test.ts)
      // caught this missing: without it, only a group's own creator could
      // ever pass this rule, making the isAdmin() check below unreachable
      // for the exact case (admin verifying someone else's group) it
      // exists for.
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        onlyChangedFields(['memberIds', 'invitedUserIds', 'eventIds', 'joinRequests']) ||
        (isAdmin() && onlyChangedFields(['isVerifiedOrganiser']))
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerifiedOrganiser']) || isAdmin());
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        // Reactions are added/removed by anyone; only the author may edit
        // (text/editedAt) or soft-delete (isDeleted, clearing text/imageUri)
        // their own message.
        allow update: if signedIn() && (
          onlyChangedFields(['reactions']) ||
          (resource.data.userId == request.auth.uid && onlyChangedFields(['text', 'editedAt', 'isDeleted', 'imageUri']))
        );
        allow delete: if false;
      }
    }

    // Mutual matches from post-event swiping
    match /mutualMatches/{matchId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.user1Id || request.auth.uid == resource.data.user2Id);
      allow create: if false; // Only Cloud Functions create these
      allow update: if false;
      allow delete: if false;
    }

    // User reports — write-only from clients; only the admin can review/resolve them.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Append-only record of admin actions (report resolutions, event
    // deletions, ID verification decisions) — a paper trail for what the
    // one moderator account did and when, in case it's ever compromised or
    // there's more than one admin someday. Never editable or deletable,
    // even by the admin themselves — that would defeat the point.
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Who's an admin/moderator — doc id = uid, e.g. { role: 'admin',
    // createdAt, createdBy }. Server/console-only: no client, including an
    // existing admin, may create/update/delete this collection through the
    // app. Seed and manage it via the Firebase Console or the Admin SDK
    // directly (bypasses rules entirely), never from a client write.
    match /admins/{uid} {
      // Anyone signed in may read their OWN doc (this is exactly what lets a
      // client check "am I an admin?" — loadUserFromFirestore reads
      // admins/{own uid} for every user on every sign-in). Without the
      // uid==own-uid branch, isAdmin() is self-blocking: a non-admin's own
      // check gets denied because they aren't already an admin, which
      // breaks profile loading for every non-admin account. Reading
      // someone else's doc (enumerating who's an admin) still requires
      // isAdmin() and is not the client-side lookup used here.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Record of images automatically removed by moderateUploadedImage
    // (Cloud Vision SafeSearch). Written only by the Admin SDK, never by a
    // client — there's no legitimate reason a client would create one of
    // these itself.
    match /moderationLog/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
